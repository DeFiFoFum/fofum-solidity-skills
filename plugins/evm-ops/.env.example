# evm-ops global credentials
# Copy to .env and fill in your values.
# This file lives in the plugin directory (~/.claude/plugins/evm-ops/.env for global installs).
# It is a fallback: project-level .env values take precedence.

# Required for etherscan-source and contract-diff
ETHERSCAN_V2_API_KEY=

# Optional chain-specific overrides (fall back to ETHERSCAN_V2_API_KEY)
# LINEASCAN_API_KEY=
# ARBISCAN_API_KEY=
# BASESCAN_API_KEY=
# POLYGONSCAN_API_KEY=

# Required for tenderly-simulate
TENDERLY_USER=
TENDERLY_PROJECT=
TENDERLY_ACCESS_KEY=

# Required for tenderly-simulate --safe-tx mode
RPC_URL=
# Chain-specific RPC overrides (optional)
# BASE_RPC_URL=
# ARBITRUM_RPC_URL=
